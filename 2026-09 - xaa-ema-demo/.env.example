# ── Okta (the enterprise IdP) ────────────────────────────────────────────────
# Your Integrator Free org, e.g. https://integrator-1234567.okta.com (org authorization server)
OKTA_ISSUER=https://YOUR-ORG.okta.com
# The "Requesting App" OIDC integration (Authorization Code + Refresh Token)
OKTA_CLIENT_ID=<Add value from Okta Client Requesting App>
OKTA_CLIENT_SECRET=<Add value from Okta Client Requesting App>
CLIENT_REDIRECT_URI=http://localhost:8080/callback

# ── Resource authorization server (this repo) ────────────────────────────────
# Must match EXACTLY the Issuer URL on the resource app's "Resource Server" tab in Okta.
# Okta won't accept an http, so run a tunnel (localtunnerl, cloudflared) to port 9000
RESOURCE_AS_ISSUER=https://localhost:9000
# The client the agent uses at THIS AS. Put the same client ID in Okta's resource connection
# ("AI agent's client ID registered in this app") so Okta writes it into the ID-JAG.
RESOURCE_AS_CLIENT_ID=demo-agent
RESOURCE_AS_CLIENT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=300
AUTO_PROVISION_USERS=true
# Set to false only if your IdP's ID-JAG header doesn't carry typ=oauth-id-jag+jwt
STRICT_ID_JAG_TYP=true

# ── MCP server (this repo) ───────────────────────────────────────────────────
MCP_RESOURCE=http://localhost:8001/mcp
RESOURCE_SCOPES=notes.read notes.write
WRITES_PER_MINUTE=5
